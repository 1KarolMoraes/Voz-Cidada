<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Espaço reservado para a Logo -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="150dp"
            android:layout_height="100dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="#E0E0E0" />

        <!-- Card Branco com os elementos de cadastro -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#FFFFFF"
            android:padding="24dp"
            app:layout_constraintTop_toBottomOf="@id/imgLogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Abas Entrar / Criar conta -->
            <LinearLayout
                android:id="@+id/layoutTabs"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:background="#F0F0F0"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <Button
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Entrar"
                    android:backgroundTint="#00000000"
                    android:textColor="#888888"
                    app:elevation="0dp" />

                <Button
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Criar conta"
                    android:backgroundTint="#FFFFFF"
                    android:textColor="#000000" />
            </LinearLayout>

            <!-- Títulos -->
            <TextView
                android:id="@+id/txtChange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Faça parte da mudança"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/layoutTabs"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/txtSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crie sua conta gratuita em poucos passos."
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/txtChange"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Campo Nome Completo -->
            <TextView
                android:id="@+id/labelNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome completo"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/txtSubtitle"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/inputNome"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:hint="Como devemos chamar você?"
                android:inputType="textPersonName"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/labelNome"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Campo E-mail -->
            <TextView
                android:id="@+id/labelEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="E-mail"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/inputNome"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/inputEmail"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:hint="voce@email.com"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/labelEmail"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Campo Senha -->
            <TextView
                android:id="@+id/labelSenha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Senha"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/inputEmail"
                app:layout_constraintStart_toStartOf="link"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/inputSenha"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:hint="Mínimo de 4 caracteres"
                android:inputType="textPassword"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/labelSenha"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Botão Criar minha conta -->
            <Button
                android:id="@+id/btnCadastrar"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:text="Criar minha conta"
                android:textColor="#333333"
                android:backgroundTint="#E0DCD8"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/inputSenha"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Termos de Uso -->
            <TextView
                android:id="@+id/txtTermos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Ao continuar, você concorda com os Termos de Uso e a Política de Privacidade."
                android:textSize="11sp"
                android:textAlignment="center"
                android:textColor="#888888"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/btnCadastrar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>