<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vc_fundo"
    android:orientation="vertical"
    tools:context=".PerfilActivity">

    <TextView
        style="@style/VozCidada.Titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        android:text="@string/perfil_titulo" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/vc_borda" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Cabeçalho do perfil -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:paddingTop="32dp"
                android:paddingBottom="24dp">

                <FrameLayout
                    android:id="@+id/avatarContainer"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:clickable="true"
                    android:focusable="true">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/white"
                        android:contentDescription="@string/perfil_titulo"
                        android:padding="14dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_person"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.VozCidada.Circulo"
                        app:strokeColor="@color/vc_azul"
                        app:strokeWidth="3dp"
                        app:tint="@color/vc_texto" />
                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_circulo_azul"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txtUsuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/vc_texto"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="karol_moraes" />
                <TextView
                    android:id="@+id/txtLocal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/vc_texto_suave"
                    android:textSize="16sp"
                    android:visibility="gone"
                    tools:text="Manaus, AM"
                    tools:visibility="visible" />
                <TextView
                    android:id="@+id/txtAviso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/vc_azul"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="Não foi possível carregar seus dados. Toque para tentar novamente."
                    tools:visibility="visible" />

                <!-- Estatísticas -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_card_stats"
                    android:orientation="horizontal"
                    android:paddingVertical="16dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/txtQtdDenuncias"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/vc_texto"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            tools:text="2" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/perfil_denuncias"
                            android:textColor="@color/vc_texto_suave"
                            android:textSize="14sp" />
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/vc_borda" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/txtQtdImpulsionadas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/vc_texto"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            tools:text="1.2k" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/perfil_impulsionadas"
                            android:textColor="@color/vc_texto_suave"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/vc_borda" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                app:tabGravity="start"
                app:tabIconTint="@color/vc_texto_suave"
                app:tabIndicatorColor="@color/vc_azul"
                app:tabMode="fixed"
                app:tabSelectedTextColor="@color/vc_azul"
                app:tabTextColor="@color/vc_texto_suave">
                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:icon="@drawable/ic_grid"
                    android:text="@string/perfil_grade" />
                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:icon="@drawable/ic_fire"
                    android:text="@string/perfil_lista" />
            </com.google.android.material.tabs.TabLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerFotos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/txtVazio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="32dp"
                android:text="@string/perfil_vazio"
                android:textColor="@color/vc_texto_suave"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSair"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_margin="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/perfil_sair"
                android:textAllCaps="false"
                android:textColor="@color/vc_azul"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@color/white"
                app:cornerRadius="20dp"
                app:strokeColor="@color/vc_borda" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/vc_borda" />
    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
