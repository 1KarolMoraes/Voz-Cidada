<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="#FFFFFF"
    android:paddingBottom="12dp">


    <!-- Cabeçalho do Post (Perfil, Nome, Rua e Tag) -->
    <ImageView
        android:id="@+id/imgAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/ic_perfil"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <TextView
        android:id="@+id/txtUsername"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:text="karol_moraes"
        android:textStyle="bold"
        android:textColor="#000000"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toTopOf="@id/imgAvatar"
        app:layout_constraintStart_toEndOf="@id/imgAvatar"
        app:layout_constraintEnd_toStartOf="@id/tagCategory" />



    <TextView
        android:id="@+id/txtLocation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:text="Rua 5, Japiim"
        android:textSize="12sp"
        android:textColor="#666666"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/txtUsername"
        app:layout_constraintStart_toEndOf="@id/imgAvatar"
        app:layout_constraintEnd_toStartOf="@id/tagCategory" />


    <TextView
        android:id="@+id/tagCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:background="#E8F0FE"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:text="INFRAESTRUTURA"
        android:textColor="#1A73E8"
        android:textSize="10sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/imgAvatar"
        app:layout_constraintBottom_toBottomOf="@id/imgAvatar"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Imagem da Denúncia -->
    <ImageView
        android:id="@+id/imgPost"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginTop="12dp"
        android:background="#E0E0E0"
        android:scaleType="fitCenter"
        android:padding="80dp"
        android:contentDescription="Ilustração da categoria da publicação"
        app:layout_constraintTop_toBottomOf="@id/imgAvatar" />

    <!-- Ações (Curtidas, Comentários, Tempo) -->
    <ImageView
        android:id="@+id/iconImpulse"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/ic_like"
        app:layout_constraintTop_toBottomOf="@id/txtCaption"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtImpulseCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="389"
        android:textColor="#000000"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/iconImpulse"
        app:layout_constraintBottom_toBottomOf="@id/iconImpulse"
        app:layout_constraintStart_toEndOf="@id/iconImpulse" />

    <ImageView
        android:id="@+id/iconComment"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/ic_comment"
        app:layout_constraintTop_toTopOf="@id/iconImpulse"
        app:layout_constraintStart_toEndOf="@id/txtImpulseCount" />

    <TextView
        android:id="@+id/txtCommentCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="2"
        android:textColor="#000000"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/iconComment"
        app:layout_constraintBottom_toBottomOf="@id/iconComment"
        app:layout_constraintStart_toEndOf="@id/iconComment" />

    <TextView
        android:id="@+id/txtTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:text="2h atrás"
        android:textSize="12sp"
        android:textColor="#888888"
        app:layout_constraintTop_toTopOf="@id/iconImpulse"
        app:layout_constraintBottom_toBottomOf="@id/iconImpulse"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Legenda do Post -->
    <TextView
        android:id="@+id/txtCaption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:text="karol_moraes Buraco enorme na calçada há mais de 2 semanas. Já caíram 3 pessoas. Urgente! #denúncia #infraestrutura"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/imgPost"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Ver / Ocultar Comentários -->
    <TextView
        android:id="@+id/txtToggleComments"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:text="Ver 2 comentários"
        android:textColor="#666666"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/iconImpulse"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>