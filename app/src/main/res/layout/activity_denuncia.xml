<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vc_fundo"
    android:orientation="vertical"
    tools:context=".DenunciaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="14dp">
        <TextView
            style="@style/VozCidada.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/denuncia_titulo" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/denuncia_subtitulo"
            android:textColor="@color/vc_texto_suave"
            android:textSize="16sp" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/vc_borda" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingTop="32dp"
            android:paddingBottom="24dp">

            <!-- Área tracejada (quadrada) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:id="@+id/areaImagem"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/bg_card_tracejado"
                    android:padding="2dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/denuncia_imagem_selecionada"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.VozCidada.Card" />

                    <LinearLayout
                        android:id="@+id/conteudoVazio"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_image"
                            app:tint="@color/vc_borda" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/denuncia_selecionar_imagem"
                            android:textColor="@color/vc_texto"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="@string/denuncia_formato"
                            android:textColor="@color/vc_texto_suave"
                            android:textSize="14sp" />
                    </LinearLayout>
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEscolherFoto"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="28dp"
                android:text="@string/denuncia_escolher_foto"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@color/vc_azul"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_camera"
                app:iconGravity="textStart"
                app:iconPadding="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinuar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/denuncia_continuar"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="@color/vc_verde"
                app:cornerRadius="26dp" />

            <!-- Dicas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/vc_borda" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:letterSpacing="0.1"
                    android:text="@string/denuncia_dicas"
                    android:textColor="@color/vc_texto_suave"
                    android:textSize="14sp" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/vc_borda" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_circulo_azul_claro" android:gravity="center" android:text="1" android:textColor="@color/vc_azul" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="@string/denuncia_dica_1" android:textColor="@color/vc_texto_suave" android:textSize="16sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_circulo_azul_claro" android:gravity="center" android:text="2" android:textColor="@color/vc_azul" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="@string/denuncia_dica_2" android:textColor="@color/vc_texto_suave" android:textSize="16sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_circulo_azul_claro" android:gravity="center" android:text="3" android:textColor="@color/vc_azul" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="@string/denuncia_dica_3" android:textColor="@color/vc_texto_suave" android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/vc_borda" />
    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
